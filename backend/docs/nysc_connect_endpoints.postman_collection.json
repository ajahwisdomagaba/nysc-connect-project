    {
      "name": "Admin",
      "item": [
        {
          "name": "List reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/reports?status=pending&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "reports"],
              "query": [
                { "key": "status", "value": "pending", "description": "pending, reviewed, resolved, dismissed, or all" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Admin token required."
          }
        },
        {
