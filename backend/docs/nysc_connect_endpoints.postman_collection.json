{
  "info": {
    "_postman_id": "b1a2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "name": "NYSC Connect API v1",
    "description": "Requests for the NYSC Connect MVP. Matches docs/API_CONTRACT_V1.md.\n\nSet baseUrl to http://localhost:5000/api/v1 or https://nysc-connect.onrender.com/api/v1.\n\nLogin and register save the JWT into the collection variable token. Protected requests send Authorization: Bearer {{token}}. Paste an admin token into token before calling the Admin folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "accommodationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "localInfoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "savedItemId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reportId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register corps member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chinedu Okafor\",\n  \"phone\": \"08012345678\",\n  \"email\": \"chinedu.okafor@email.com\",\n  \"password\": \"Password123!\",\n  \"state\": \"Lagos\",\n  \"lga\": \"Ikeja\",\n  \"ppa\": \"State High School\",\n  \"role\": \"corps_member\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "ppa and ppa_name are optional and store the same field. role defaults to corps_member."
          }
        },
        {
          "name": "Register landlord",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('token', body.token);",
                  "if (body.user && body.user.id) pm.collectionVariables.set('userId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Okonkwo\",\n  \"phone\": \"08098765432\",\n  \"email\": \"ada.okonkwo@email.com\",\n  \"password\": \"Password123!\",\n  \"state\": \"Lagos\",\n  \"lga\": \"Ikeja\",\n  \"role\": \"landlord\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "role may be landlord or agent. Admin self-registration is rejected."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('token', body.token);",
                  "if (body.user && body.user.id) pm.collectionVariables.set('userId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"08012345678\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login is by phone and password. The response token is saved to the token variable."
          }
        },
        {
          "name": "Get current user (auth/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Get current user (users/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Update location and PPA",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"Lagos\",\n  \"lga\": \"Kosofe\",\n  \"ppa\": \"Kosofe Local Government Secretariat\",\n  \"ppa_proximity\": \"Approximately 10 minutes to the secretariat\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Send ppa or ppa_name. Both write ppa_name. ppa_proximity is optional."
          }
        }
      ]
    },
    {
      "name": "Account verification",
      "item": [
        {
          "name": "Get my verification",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me/verification",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "verification"]
            },
            "description": "Landlord or agent only. This is account verification, separate from listing approval."
          }
        },
        {
          "name": "Submit landlord verification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_type\": \"nin\",\n  \"id_document_url\": \"https://res.cloudinary.com/demo/image/upload/nin.jpg\",\n  \"authority_type\": \"utility_bill\",\n  \"authority_document_url\": \"https://res.cloudinary.com/demo/image/upload/bill.jpg\",\n  \"prepaid_meter_number\": \"04123456789\",\n  \"zero_upfront_fee_agreed\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/verification",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "verification"]
            },
            "description": "Upload both images first with POST /media/verification-documents. Landlord authority_type is utility_bill or proof_of_ownership. prepaid_meter_number is required for utility_bill."
          }
        },
        {
          "name": "Submit agent verification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_type\": \"drivers_license\",\n  \"id_document_url\": \"https://res.cloudinary.com/demo/image/upload/license.jpg\",\n  \"authority_type\": \"authorization_letter\",\n  \"authority_document_url\": \"https://res.cloudinary.com/demo/image/upload/mandate.jpg\",\n  \"zero_upfront_fee_agreed\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/verification",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "verification"]
            },
            "description": "Agent authority_type is authorization_letter or agency_registration. id_type is nin, pvc, drivers_license, or passport."
          }
        }
      ]
    },
    {
      "name": "Locations",
