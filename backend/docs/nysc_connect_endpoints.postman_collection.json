    {
      "name": "Accommodations",
      "item": [
        {
          "name": "Search accommodations (Ikeja)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accommodations?state=Lagos&lga=Ikeja&accommodationType=self-contain&sort=newest&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["accommodations"],
              "query": [
                { "key": "state", "value": "Lagos" },
                { "key": "lga", "value": "Ikeja" },
                { "key": "minPrice", "value": "100000", "disabled": true },
                { "key": "maxPrice", "value": "500000", "disabled": true },
                { "key": "accommodationType", "value": "self-contain", "description": "single-room, self-contain, room-and-parlour, one-bedroom, two-bedroom, shared-apartment" },
                { "key": "amenities", "value": "", "disabled": true },
                { "key": "sort", "value": "newest", "description": "newest, price_asc, price_desc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Public feed. Only status active and verification_status verified. Results are in data.results with page, limit, total, and totalPages."
          }
        },
        {
          "name": "Search accommodations (Ibadan North)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accommodations?state=Oyo&lga=Ibadan North",
              "host": ["{{baseUrl}}"],
              "path": ["accommodations"],
              "query": [
                { "key": "state", "value": "Oyo" },
                { "key": "lga", "value": "Ibadan North" }
              ]
            }
          }
        },
        {
          "name": "Search accommodations (Kosofe)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accommodations?state=Lagos&lga=Kosofe",
              "host": ["{{baseUrl}}"],
              "path": ["accommodations"],
              "query": [
                { "key": "state", "value": "Lagos" },
                { "key": "lga", "value": "Kosofe" }
              ]
            }
          }
        },
        {
          "name": "List my accommodations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accommodations/mine?verificationStatus=all&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["accommodations", "mine"],
              "query": [
                { "key": "verificationStatus", "value": "all", "description": "pending, verified, rejected, flagged, or all" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Landlord, agent, or admin. Includes pending and rejected listings."
          }
        },
        {
          "name": "Get accommodation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accommodations/{{accommodationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accommodations", "{{accommodationId}}"]
            },
            "description": "Requires a Bearer token. Unpublished listings are visible only to an admin or the owner."
          }
        },
        {
          "name": "Create accommodation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data._id) pm.collectionVariables.set('accommodationId', body.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Room and parlor mini flat near Oregun\",\n  \"description\": \"Spacious flat with separate living room, balcony, and steady water.\",\n  \"accommodationType\": \"room-and-parlour\",\n  \"price\": 450000,\n  \"caution_fee\": 50000,\n  \"agency_fee\": 20000,\n  \"address\": \"8 Kudirat Abiola Way, Oregun, Ikeja, Lagos\",\n  \"state\": \"Lagos\",\n  \"lga\": \"Ikeja\",\n  \"ppa_proximity\": \"Approximately 12 mins transit to Ikeja PPA clusters\",\n  \"contact_phone\": \"08044556677\",\n  \"contact_whatsapp\": \"08044556677\",\n  \"property_info\": [\"car_park\", \"borehole_water\"],\n  \"photos\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accommodations",
              "host": ["{{baseUrl}}"],
              "path": ["accommodations"]
            },
            "description": "Verified landlord or agent, or admin. The account must already be verified. The listing is saved as verification_status pending. accommodationType defaults to self-contain. caution_fee and agency_fee default to 0. Aliases: annualRent, cautionFee, agencyFee. There is no separate bedroom count and no document field."
          }
        },
        {
          "name": "Update accommodation",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Room and parlor mini flat near Oregun\",\n  \"description\": \"Updated description after correction.\",\n  \"accommodationType\": \"room-and-parlour\",\n  \"price\": 450000,\n  \"caution_fee\": 50000,\n  \"agency_fee\": 20000,\n  \"address\": \"8 Kudirat Abiola Way, Oregun, Ikeja, Lagos\",\n  \"state\": \"Lagos\",\n  \"lga\": \"Ikeja\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accommodations/{{accommodationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accommodations", "{{accommodationId}}"]
            },
            "description": "Owner or admin. Editing a verified listing sets verification_status back to pending. Editing a rejected listing does not."
          }
        },
        {
          "name": "Archive accommodation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accommodations/{{accommodationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accommodations", "{{accommodationId}}"]
            },
            "description": "Soft delete. Sets status to archived."
          }
        }
      ]
    },
